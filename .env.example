PORT=
DATABASE_URL=
DATABASE_URL_TEST=
REDIS_URL=
JWT_SECRET=
# Access token lifetime: a number plus s/m/h/d (default 15m). e.g. 8h for
# development; keep it short in production, there are no refresh tokens yet.
JWT_EXPIRY=
ADMIN_TOKEN=
FINSIGHT_LLM_BASE_URL=
FINSIGHT_LLM_API_KEY=
FINSIGHT_LLM_MODEL=
# Comma-separated exact origins (scheme://host:port, no trailing slash), e.g.
# CORS_ORIGINS=http://localhost:5173 for the Vite dev server. Empty means none.
CORS_ORIGINS=
# Optional overrides (defaults shown). Leave commented rather than empty.
# RATE_LIMIT_ASK_PER_MIN=20
# RATE_LIMIT_LOGIN_PER_15MIN=10
# RATE_LIMIT_REGISTER_PER_HOUR=5
# RATE_LIMIT_UPLOAD_PER_HOUR=30
# LLM_DAILY_BUDGET_PER_TENANT=200
