{
  "name": "finsight",
  "version": "1.0.0",
  "description": "Financial Operations & Intelligence Platform",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "worker": "node --watch src/worker.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 --import ./test/setup.js \"test/**/*.test.js\"",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "drizzle-kit migrate --config=drizzle.test.config.js",
    "warm-model": "node scripts/warm-model.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.4",
    "cors": "^2.8.6",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.44.0",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0"
  }
}
